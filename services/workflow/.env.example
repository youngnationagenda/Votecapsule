# VoteCapsule Workflow Engine — Environment Variables
# Copy to .env for local development. Never commit .env to git.

# HTTP Server
PORT=3007
NODE_ENV=development

# Aurora PostgreSQL (shared cluster)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=votecapsule
DB_USER=votecapsule
DB_PASS=changeme
DB_SSL=false
DB_POOL_MAX=10

# AWS Core
AWS_REGION=us-east-1
# For ECS with instance profiles, leave credentials blank (uses IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Step Functions — State machine ARNs (set after CDK deploy)
SFN_EVIDENCE_CAPSULE_ARN=arn:aws:states:us-east-1:683541453923:stateMachine:VoteCapsuleEvidenceCapsule
SFN_TENANT_PROVISIONING_ARN=arn:aws:states:us-east-1:683541453923:stateMachine:VoteCapsuleTenantProvisioning
SFN_USER_ONBOARDING_ARN=arn:aws:states:us-east-1:683541453923:stateMachine:VoteCapsuleUserOnboarding
SFN_RESULTS_PUBLICATION_ARN=arn:aws:states:us-east-1:683541453923:stateMachine:VoteCapsuleResultsPublication
SFN_RECOVERY_ARN=arn:aws:states:us-east-1:683541453923:stateMachine:VoteCapsuleRecovery
SFN_ESCALATION_ARN=arn:aws:states:us-east-1:683541453923:stateMachine:VoteCapsuleEscalation
SFN_ASSIGNMENT_ARN=arn:aws:states:us-east-1:683541453923:stateMachine:VoteCapsuleAssignment

# Amazon EventBridge
EVENT_BUS_NAME=votecapsule-events

# SQS Validation Queue (used by EVIDENCE_CAPSULE waitForTaskToken step)
VALIDATION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/683541453923/votecapsule-validation

# Cross-Service URLs (use ECS DNS names in production)
EVIDENCE_SERVICE_URL=http://localhost:3005
AI_SERVICE_URL=http://localhost:3006
GEOGRAPHY_SERVICE_URL=http://localhost:3004
TRUST_SERVICE_URL=http://localhost:3003
IDENTITY_SERVICE_URL=http://localhost:3001

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://votecapsule.yna.co.ke
