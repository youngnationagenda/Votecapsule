    "@nestjs/typeorm": "^10.0.0",
    "@opensearch-project/opensearch": "^3.2.0",
    "aws4": "^1.13.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
