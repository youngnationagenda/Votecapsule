{
  "name": "@vote-capsule/integration-tests",
  "version": "1.0.0",
  "private": true,
  "description": "VoteCapsule Integration Test Suite — Evidence Pipeline, Reconciliation, Election Lifecycle",
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "test:health": "jest --runInBand --forceExit health-check",
    "test:evidence": "jest --runInBand --forceExit evidence-pipeline",
    "test:reconciliation": "jest --runInBand --forceExit reconciliation",
    "test:election": "jest --runInBand --forceExit election-lifecycle",
    "test:ci": "jest --runInBand --forceExit --ci --reporters=default --reporters=jest-junit"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.600.0",
    "axios": "^1.7.0",
    "form-data": "^4.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
