              { "Name": "WORKFLOW_SERVICE_URL","Value": "http://vote-capsule-services-alb-181601180.us-east-1.elb.amazonaws.com/api/v1/workflow" },
              { "Name": "ALLOWED_ORIGINS",     "Value": "http://localhost:3000,https://votecapsule.yna.co.ke" }
            ],
            "Secrets": [
              {
                "Name": "DB_PASS",
                "ValueFrom": "arn:aws:secretsmanager:us-east-1:683541453923:secret:vote-capsule/database/credentials-zTDMLX:password::"
              },
              {
                "Name": "FIREBASE_SERVICE_ACCOUNT",
                "ValueFrom": "arn:aws:secretsmanager:us-east-1:683541453923:secret:vote-capsule/firebase/service-account-RioPSx"
              }
            ]
          }
        ],
        "Tags": [
          { "Key": "Project", "Value": "VoteCapsule" },
          { "Key": "Service", "Value": "notification" }
        ]
      }
    },

    "NotificationTG": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": "vc-notification-tg",
        "Port": 3008,
        "Protocol": "HTTP",
        "VpcId": "vpc-0ae6f8630af9fbfdc",
        "TargetType": "ip",
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckTimeoutSeconds": 5,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": { "HttpCode": "200,404" },
        "Tags": [
          { "Key": "Project", "Value": "VoteCapsule" },
          { "Key": "Service", "Value": "notification" }
        ]
      }
    },

    "NotificationRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": "arn:aws:elasticloadbalancing:us-east-1:683541453923:listener/app/vote-capsule-services-alb/aef21c0dc2379121/8cfcb22850289df4",
        "Priority": 80,
        "Conditions": [
          { "Field": "path-pattern", "Values": ["/api/v1/notification/*"] }
        ],
        "Actions": [
          { "Type": "forward", "TargetGroupArn": { "Ref": "NotificationTG" } }
        ]
      }
    },

    "NotificationService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": ["NotificationRule"],
      "Properties": {
        "ServiceName": "vc-notification",
        "Cluster": "arn:aws:ecs:us-east-1:683541453923:cluster/vote-capsule-services",
        "TaskDefinition": { "Ref": "NotificationTD" },
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              "subnet-0aa1a58541c87ae2a",
              "subnet-0171d821c5d5ae868",
              "subnet-0be09dbd825b75c07",
              "subnet-09604eb63697ac228"
            ],
            "SecurityGroups": [{ "Fn::GetAtt": ["NotificationSG", "GroupId"] }],
            "AssignPublicIp": "ENABLED"
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "vc-notification",
            "ContainerPort": 3008,
            "TargetGroupArn": { "Ref": "NotificationTG" }
          }
        ],
        "HealthCheckGracePeriodSeconds": 90,
        "Tags": [
          { "Key": "Project", "Value": "VoteCapsule" },
          { "Key": "Service", "Value": "notification" }
        ]
      }
    },

