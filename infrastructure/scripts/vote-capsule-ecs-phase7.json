{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "VoteCapsule Phase 7 ECS Task Definitions + Services: Notification (3008), Candidate (3009), Reporting (3010), Election (3011) + ALB routing rules (Tasks 17/18 Phase 7)",

  "Resources": {

    "NotificationSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupName": "vc-notification-sg",
        "GroupDescription": "VoteCapsule notification ECS tasks",
        "VpcId": "vpc-0ae6f8630af9fbfdc",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3008,
            "ToPort": 3008,
            "SourceSecurityGroupId": "sg-0141328242fe8f272",
            "Description": "From ALB"
          }
        ],
        "Tags": [
          { "Key": "Project", "Value": "VoteCapsule" },
          { "Key": "Service", "Value": "notification" }
        ]
      }
    },

    "NotificationTD": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "vc-notification",
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "ExecutionRoleArn": "arn:aws:iam::683541453923:role/vote-capsule-ecs-task-execution-role",
