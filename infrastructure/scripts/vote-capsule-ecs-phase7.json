            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": "/vote-capsule/services/notification",
                "awslogs-region": "us-east-1",
                "awslogs-stream-prefix": "notification",
                "awslogs-create-group": "true"
              }
            },
            "Environment": [
              { "Name": "NODE_ENV",            "Value": "production" },
              { "Name": "PORT",                "Value": "3008" },
              { "Name": "AWS_REGION",          "Value": "us-east-1" },
              { "Name": "DB_HOST",             "Value": "vote-capsule-db.cluster-c43i6c8ow71c.us-east-1.rds.amazonaws.com" },
              { "Name": "DB_PORT",             "Value": "5432" },
              { "Name": "DB_NAME",             "Value": "votecapsule" },
              { "Name": "DB_USER",             "Value": "vcadmin" },
              { "Name": "DB_SSL",              "Value": "true" },
              { "Name": "DB_POOL_MAX",         "Value": "10" },
              { "Name": "SES_FROM_ADDRESS",    "Value": "noreply@votecapsule.yna.co.ke" },
