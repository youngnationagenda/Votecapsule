{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Vote Capsule Secrets Stack - AWS Secrets Manager for all service credentials",
  "Resources": {
    "DatabaseSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": "vote-capsule/database/credentials",
        "Description": "Vote Capsule Aurora PostgreSQL credentials",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\": \"vcadmin\"}",
          "GenerateStringKey": "password",
          "ExcludeCharacters": " %+~`#$&*()|[]{}:;<>?!'/\\\"@"
        },
        "Tags": [
          { "Key": "Project", "Value": "VoteCapsule" },
          { "Key": "ManagedBy", "Value": "CloudFormation" }
        ]
      }
    },
    "JwtSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": "vote-capsule/jwt/secret",
        "Description": "Vote Capsule JWT signing secret for Identity Service",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"key\": \"placeholder\"}",
          "GenerateStringKey": "secret",
          "PasswordLength": 64,
          "ExcludeCharacters": " %+~`#$&*()|[]{}:;<>?!'/\\\"@"
        },
        "Tags": [
          { "Key": "Project", "Value": "VoteCapsule" },
          { "Key": "Service", "Value": "identity" }
        ]
      }
    }
  },
  "Outputs": {
    "DatabaseSecretArn": {
      "Value": { "Ref": "DatabaseSecret" },
      "Export": { "Name": "VoteCapsule-DatabaseSecretArn" }
    },
    "JwtSecretArn": {
      "Value": { "Ref": "JwtSecret" },
      "Export": { "Name": "VoteCapsule-JwtSecretArn" }
    }
  }
}
