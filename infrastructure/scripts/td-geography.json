{
  "family": "vc-geography",
  "cpu": "512", "memory": "1024",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::683541453923:role/vote-capsule-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::683541453923:role/vote-capsule-ecs-task-execution-role",
  "containerDefinitions": [{
    "name": "geography-service",
    "image": "683541453923.dkr.ecr.us-east-1.amazonaws.com/vote-capsule/geography-service:latest",
    "portMappings": [{"containerPort": 3004, "protocol": "tcp"}],
    "essential": true,
    "environment": [
      {"name": "PORT", "value": "3004"}, {"name": "NODE_ENV", "value": "production"},
      {"name": "DB_HOST", "value": "vote-capsule-db.cluster-c43i6c8ow71c.us-east-1.rds.amazonaws.com"},
      {"name": "DB_PORT", "value": "5432"}, {"name": "DB_NAME", "value": "votecapsule"},
      {"name": "DB_USER", "value": "vcadmin"}, {"name": "DB_SSL", "value": "true"},
      {"name": "AWS_REGION", "value": "us-east-1"}, {"name": "ALLOWED_ORIGINS", "value": "*"}
    ],
    "secrets": [{"name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:683541453923:secret:vote-capsule/database/credentials-zTDMLX:password::"}],
    "logConfiguration": {"logDriver": "awslogs", "options": {"awslogs-group": "/vote-capsule/geography-service", "awslogs-region": "us-east-1", "awslogs-stream-prefix": "geography", "awslogs-create-group": "true"}},
    "healthCheck": {"command": ["CMD-SHELL", "curl -f http://localhost:3004/api/v1/geography/health || exit 1"], "interval": 30, "timeout": 5, "retries": 3, "startPeriod": 90}
  }]
}
