{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadSupplierImages",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::votecapsule-campaign-assets/suppliers/*",
        "arn:aws:s3:::votecapsule-campaign-assets/designs/*",
        "arn:aws:s3:::votecapsule-campaign-assets/thumbnails/*",
        "arn:aws:s3:::votecapsule-campaign-assets/previews/*"
      ]
    }
  ]
}
