{
  "family": "vc-trust",
  "cpu": "512",
  "memory": "1024",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::683541453923:role/vote-capsule-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::683541453923:role/vote-capsule-ecs-task-execution-role",
  "containerDefinitions": [
    {
      "name": "vc-trust",
      "image": "683541453923.dkr.ecr.us-east-1.amazonaws.com/vote-capsule/trust-service:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 3003, "protocol": "tcp" }],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/vote-capsule/services/trust",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "trust",
          "awslogs-create-group": "true"
        }
      },
      "environment": [
        { "name": "NODE_ENV",              "value": "production" },
        { "name": "PORT",                  "value": "3003" },
        { "name": "AWS_REGION",            "value": "us-east-1" },
        { "name": "DB_HOST",               "value": "vote-capsule-db.cluster-c43i6c8ow71c.us-east-1.rds.amazonaws.com" },
        { "name": "DB_PORT",               "value": "5432" },
        { "name": "DB_NAME",               "value": "votecapsule" },
        { "name": "DB_USER",               "value": "vcadmin" },
        { "name": "DB_SSL",                "value": "true" },
        { "name": "DB_POOL_MAX",           "value": "10" },
        { "name": "EVENT_BUS_NAME",        "value": "votecapsule-events" },
        { "name": "SQS_VALIDATION_URL",    "value": "https://sqs.us-east-1.amazonaws.com/683541453923/votecapsule-validation" },
        { "name": "S3_EVIDENCE_VAULT",     "value": "vote-capsule-evidence-vault-683541453923" },
        { "name": "COGNITO_USER_POOL_ID",  "value": "us-east-1_i3N2tg34A" },
        { "name": "COGNITO_CLIENT_ID",     "value": "3hi86ci06546ki038k6msmik0s" },
        { "name": "HEDERA_NETWORK",        "value": "testnet" },
        { "name": "TSA_URL",               "value": "https://freetsa.org/tsr" },
        { "name": "MERKLE_BATCH_INTERVAL_MS", "value": "60000" }
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:683541453923:secret:vote-capsule/database/credentials-zTDMLX:password::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:683541453923:secret:vote-capsule/jwt/secret-bB2dDP:secret::"
        },
        {
          "name": "HEDERA_CREDENTIALS",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:683541453923:secret:vote-capsule/hedera/credentials-gB1zWE"
        }
      ]
    }
  ],
  "tags": [
    { "key": "Project", "value": "VoteCapsule" },
    { "key": "Service", "value": "trust" }
  ]
}
