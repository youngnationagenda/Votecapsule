{
  "Comment": "VoteCapsule Evidence Pipeline — Orchestrates capsule upload, AI verification, trust anchoring, and agent notification via SQS/EventBridge.",
  "StartAt": "PublishUploadEvent",
  "States": {
    "PublishUploadEvent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "https://sqs.us-east-1.amazonaws.com/683541453923/votecapsule-validation",
        "MessageBody": {
          "action": "CAPSULE_RECEIVED",
          "capsuleId.$": "$.capsuleId",
          "agentUserId.$": "$.agentUserId",
          "tenantId.$": "$.tenantId",
          "electionId.$": "$.electionId",
          "stationId.$": "$.stationId",
          "imageSHA256.$": "$.imageSHA256",
          "captureTimestamp.$": "$.captureTimestamp",
          "fileKey.$": "$.fileKey"
        }
      },
      "ResultPath": "$.sqsResult",
      "Next": "WaitForAIVerification"
    },

    "WaitForAIVerification": {
      "Type": "Wait",
      "Comment": "Wait 45 seconds for Evidence Service to pick up from SQS and trigger AI verification",
      "Seconds": 45,
      "Next": "PublishTrustAnchorEvent"
    },

    "PublishTrustAnchorEvent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "votecapsule-events",
            "Source": "vote-capsule.step-functions",
            "DetailType": "TrustAnchorRequest",
            "Detail": {
              "capsuleId.$": "$.capsuleId",
              "tenantId.$": "$.tenantId",
              "electionId.$": "$.electionId",
              "imageSHA256.$": "$.imageSHA256",
              "captureTimestamp.$": "$.captureTimestamp"
            }
          }
        ]
      },
      "ResultPath": "$.trustEvent",
      "Next": "WaitForAnchor"
    },

    "WaitForAnchor": {
      "Type": "Wait",
      "Comment": "Wait 75 seconds for Hedera + RFC 3161 dual anchor (60s batch interval + buffer)",
      "Seconds": 75,
      "Next": "PublishNotifyAgentEvent"
    },

    "PublishNotifyAgentEvent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "votecapsule-events",
            "Source": "vote-capsule.step-functions",
            "DetailType": "NotifyAgent",
            "Detail": {
              "agentUserId.$": "$.agentUserId",
              "capsuleId.$": "$.capsuleId",
              "tenantId.$": "$.tenantId",
              "message": "Your evidence capsule has been verified and anchored. It is now tamper-proof."
            }
          }
        ]
      },
      "ResultPath": "$.notifyEvent",
      "Next": "PipelineComplete"
    },

    "PipelineComplete": {
      "Type": "Succeed",
      "Comment": "Evidence pipeline dispatched successfully. Services process asynchronously via SQS/EventBridge."
    }
  }
}
