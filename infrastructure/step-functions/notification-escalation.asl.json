{
  "Comment": "VoteCapsule Notification Escalation — Routes alerts by severity via SQS and EventBridge.",
  "StartAt": "CheckSeverity",
  "States": {
    "CheckSeverity": {
      "Type": "Choice",
      "Comment": "Route based on alert severity level",
      "Choices": [
        {"Variable": "$.severity", "StringEquals": "CRITICAL", "Next": "PublishCriticalAlert"},
        {"Variable": "$.severity", "StringEquals": "HIGH", "Next": "PublishHighAlert"},
        {"Variable": "$.severity", "StringEquals": "MEDIUM", "Next": "PublishMediumAlert"}
      ],
      "Default": "PublishLowAlert"
    },

    "PublishCriticalAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "votecapsule-events",
            "Source": "vote-capsule.step-functions",
            "DetailType": "CriticalAlert",
            "Detail": {
              "alertType.$": "$.alertType",
              "message.$": "$.message",
              "resourceId.$": "$.resourceId",
              "tenantId.$": "$.tenantId",
              "severity": "CRITICAL",
              "channels": ["PUSH", "EMAIL", "SMS"],
              "recipients": ["SUPER_ADMIN", "OPS_TEAM", "IEBC_ADMIN"]
            }
          }
        ]
      },
      "ResultPath": "$.alertEvent",
      "Next": "WaitForAcknowledgement"
    },

    "PublishHighAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "votecapsule-events",
            "Source": "vote-capsule.step-functions",
            "DetailType": "HighAlert",
            "Detail": {
              "alertType.$": "$.alertType",
              "message.$": "$.message",
              "resourceId.$": "$.resourceId",
              "tenantId.$": "$.tenantId",
              "severity": "HIGH",
              "channels": ["PUSH", "EMAIL"],
              "recipients": ["SUPER_ADMIN", "OPS_TEAM"]
            }
          }
        ]
      },
      "ResultPath": "$.alertEvent",
      "Next": "EscalationComplete"
    },

    "PublishMediumAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "votecapsule-events",
            "Source": "vote-capsule.step-functions",
            "DetailType": "MediumAlert",
            "Detail": {
              "alertType.$": "$.alertType",
              "message.$": "$.message",
              "resourceId.$": "$.resourceId",
              "tenantId.$": "$.tenantId",
              "severity": "MEDIUM",
              "channels": ["PUSH"],
              "recipients": ["TENANT_ADMIN"]
            }
          }
        ]
      },
      "ResultPath": "$.alertEvent",
      "Next": "EscalationComplete"
    },

    "PublishLowAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "https://sqs.us-east-1.amazonaws.com/683541453923/votecapsule-validation",
        "MessageBody": {
          "action": "LOW_PRIORITY_ALERT",
          "alertType.$": "$.alertType",
          "message.$": "$.message",
          "tenantId.$": "$.tenantId",
          "severity": "LOW"
        }
      },
      "ResultPath": "$.sqsResult",
      "Next": "EscalationComplete"
    },

    "WaitForAcknowledgement": {
      "Type": "Wait",
      "Comment": "Wait 30 minutes for critical alert acknowledgement",
      "Seconds": 1800,
      "Next": "PublishEscalationReminder"
    },

    "PublishEscalationReminder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "votecapsule-events",
            "Source": "vote-capsule.step-functions",
            "DetailType": "UnacknowledgedCriticalAlert",
            "Detail": {
              "alertType.$": "$.alertType",
              "message.$": "$.message",
              "resourceId.$": "$.resourceId",
              "tenantId.$": "$.tenantId",
              "minutesUnacknowledged": 30
            }
          }
        ]
      },
      "ResultPath": "$.reminderEvent",
      "Next": "EscalationComplete"
    },

    "EscalationComplete": {
      "Type": "Succeed",
      "Comment": "Notification escalation events published successfully."
    }
  }
}
