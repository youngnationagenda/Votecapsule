{
  "Comment": "VoteCapsule Election Lifecycle — Publishes election state transition events to EventBridge.",
  "StartAt": "ValidateTransition",
  "States": {
    "ValidateTransition": {
      "Type": "Choice",
      "Comment": "Route based on target election state",
      "Choices": [
        {"Variable": "$.targetState", "StringEquals": "NOMINATION", "Next": "PublishNominationOpened"},
        {"Variable": "$.targetState", "StringEquals": "CAMPAIGN", "Next": "PublishCampaignStarted"},
        {"Variable": "$.targetState", "StringEquals": "ACTIVE", "Next": "PublishElectionActivated"},
        {"Variable": "$.targetState", "StringEquals": "TALLYING", "Next": "PublishTallyingStarted"},
        {"Variable": "$.targetState", "StringEquals": "RESULTS_PUBLISHED", "Next": "PublishResultsPublished"},
        {"Variable": "$.targetState", "StringEquals": "CLOSED", "Next": "PublishElectionClosed"}
      ],
      "Default": "InvalidTransition"
    },

    "PublishNominationOpened": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [{"EventBusName": "votecapsule-events", "Source": "vote-capsule.step-functions", "DetailType": "ElectionNominationOpened", "Detail": {"electionId.$": "$.electionId", "tenantId.$": "$.tenantId", "triggeredBy.$": "$.triggeredBy"}}]
      },
      "ResultPath": "$.event",
      "Next": "TransitionComplete"
    },

    "PublishCampaignStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [{"EventBusName": "votecapsule-events", "Source": "vote-capsule.step-functions", "DetailType": "ElectionCampaignStarted", "Detail": {"electionId.$": "$.electionId", "tenantId.$": "$.tenantId", "triggeredBy.$": "$.triggeredBy"}}]
      },
      "ResultPath": "$.event",
      "Next": "TransitionComplete"
    },

    "PublishElectionActivated": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [{"EventBusName": "votecapsule-events", "Source": "vote-capsule.step-functions", "DetailType": "ElectionActivated", "Detail": {"electionId.$": "$.electionId", "tenantId.$": "$.tenantId", "triggeredBy.$": "$.triggeredBy"}}]
      },
      "ResultPath": "$.event",
      "Next": "TransitionComplete"
    },

    "PublishTallyingStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [{"EventBusName": "votecapsule-events", "Source": "vote-capsule.step-functions", "DetailType": "ElectionTallyingStarted", "Detail": {"electionId.$": "$.electionId", "tenantId.$": "$.tenantId", "triggeredBy.$": "$.triggeredBy"}}]
      },
      "ResultPath": "$.event",
      "Next": "TransitionComplete"
    },

    "PublishResultsPublished": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [{"EventBusName": "votecapsule-events", "Source": "vote-capsule.step-functions", "DetailType": "ElectionResultsPublished", "Detail": {"electionId.$": "$.electionId", "tenantId.$": "$.tenantId", "triggeredBy.$": "$.triggeredBy"}}]
      },
      "ResultPath": "$.event",
      "Next": "TransitionComplete"
    },

    "PublishElectionClosed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [{"EventBusName": "votecapsule-events", "Source": "vote-capsule.step-functions", "DetailType": "ElectionClosed", "Detail": {"electionId.$": "$.electionId", "tenantId.$": "$.tenantId", "triggeredBy.$": "$.triggeredBy"}}]
      },
      "ResultPath": "$.event",
      "Next": "TransitionComplete"
    },

    "TransitionComplete": {
      "Type": "Succeed",
      "Comment": "Election lifecycle transition event published successfully."
    },

    "InvalidTransition": {
      "Type": "Fail",
      "Cause": "Invalid target state provided",
      "Error": "InvalidElectionTransition"
    }
  }
}
