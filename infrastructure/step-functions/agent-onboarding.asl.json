{
  "Comment": "VoteCapsule Agent Onboarding — Publishes onboarding events to EventBridge for Identity, Notification, and Workflow services.",
  "StartAt": "PublishOnboardingStarted",
  "States": {
    "PublishOnboardingStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "votecapsule-events",
            "Source": "vote-capsule.step-functions",
            "DetailType": "AgentOnboardingStarted",
            "Detail": {
              "agentUserId.$": "$.agentUserId",
              "tenantId.$": "$.tenantId",
              "stationId.$": "$.stationId",
              "deviceId.$": "$.deviceId"
            }
          }
        ]
      },
      "ResultPath": "$.startEvent",
      "Next": "WaitForDeviceRegistration"
    },

    "WaitForDeviceRegistration": {
      "Type": "Wait",
      "Comment": "Wait 10 seconds for Identity Service to register device",
      "Seconds": 10,
      "Next": "PublishTrainingRequired"
    },

    "PublishTrainingRequired": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "votecapsule-events",
            "Source": "vote-capsule.step-functions",
            "DetailType": "AgentTrainingRequired",
            "Detail": {
              "agentUserId.$": "$.agentUserId",
              "tenantId.$": "$.tenantId",
              "stationId.$": "$.stationId",
              "message": "Please complete the evidence capture training before election day."
            }
          }
        ]
      },
      "ResultPath": "$.trainingEvent",
      "Next": "PublishWorkflowAssignment"
    },

    "PublishWorkflowAssignment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "https://sqs.us-east-1.amazonaws.com/683541453923/votecapsule-validation",
        "MessageBody": {
          "action": "AGENT_STATION_ASSIGNED",
          "agentUserId.$": "$.agentUserId",
          "tenantId.$": "$.tenantId",
          "stationId.$": "$.stationId",
          "electionId.$": "$.electionId"
        }
      },
      "ResultPath": "$.workflowAssignment",
      "Next": "OnboardingComplete"
    },

    "OnboardingComplete": {
      "Type": "Succeed",
      "Comment": "Agent onboarding events dispatched successfully."
    }
  }
}
