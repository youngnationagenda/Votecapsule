{
  "Comment": "VoteCapsule Billing Cycle — Monthly subscription renewal and invoice generation via EventBridge.",
  "StartAt": "PublishBillingCycleStarted",
  "States": {
    "PublishBillingCycleStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "votecapsule-events",
            "Source": "vote-capsule.step-functions",
            "DetailType": "BillingCycleStarted",
            "Detail": {
              "tenantId.$": "$.tenantId",
              "subscriptionId.$": "$.subscriptionId",
              "billingPeriod.$": "$.billingPeriod",
              "amount.$": "$.amount",
              "currency.$": "$.currency"
            }
          }
        ]
      },
      "ResultPath": "$.billingEvent",
      "Next": "WaitForInvoiceGeneration"
    },

    "WaitForInvoiceGeneration": {
      "Type": "Wait",
      "Comment": "Wait 5 seconds for Billing Service to generate invoice",
      "Seconds": 5,
      "Next": "PublishPaymentRequired"
    },

    "PublishPaymentRequired": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "votecapsule-events",
            "Source": "vote-capsule.step-functions",
            "DetailType": "PaymentRequired",
            "Detail": {
              "tenantId.$": "$.tenantId",
              "subscriptionId.$": "$.subscriptionId",
              "billingPeriod.$": "$.billingPeriod",
              "amount.$": "$.amount"
            }
          }
        ]
      },
      "ResultPath": "$.paymentEvent",
      "Next": "WaitForPayment"
    },

    "WaitForPayment": {
      "Type": "Wait",
      "Comment": "Wait 3 days for payment processing (259200 seconds)",
      "Seconds": 259200,
      "Next": "PublishPaymentReminder"
    },

    "PublishPaymentReminder": {
      "Type": "Task",
      "Resource": "arn:aws:states:::events:putEvents",
      "Parameters": {
        "Entries": [
          {
            "EventBusName": "votecapsule-events",
            "Source": "vote-capsule.step-functions",
            "DetailType": "PaymentReminder",
            "Detail": {
              "tenantId.$": "$.tenantId",
              "subscriptionId.$": "$.subscriptionId",
              "daysOverdue": 3
            }
          }
        ]
      },
      "ResultPath": "$.reminderEvent",
      "Next": "BillingCycleComplete"
    },

    "BillingCycleComplete": {
      "Type": "Succeed",
      "Comment": "Billing cycle events dispatched. Billing Service processes payment asynchronously."
    }
  }
}
