# pnpm hoisting rules for Metro bundler compatibility
# Metro cannot resolve packages through deep pnpm symlink chains on Windows.
# Hoist critical packages that Metro needs to find at the app root.
public-hoist-pattern[]=@babel/runtime
public-hoist-pattern[]=@babel/runtime-corejs*
public-hoist-pattern[]=react
public-hoist-pattern[]=react-native
public-hoist-pattern[]=react-native-*
public-hoist-pattern[]=@react-native*
public-hoist-pattern[]=expo
public-hoist-pattern[]=expo-*
